menu "Cellular Project"

config COAP_SERVER_HOSTNAME
    string "CoAP server hostname"

config COAP_SERVER_PORT
    int "CoAP server port"
    default 5683

config FIRMARE_VERSION
    string "Firmware version"
    default "1.0.0"


config COAP_TX_RESOURCE
    string "CoAP resource - this is the TX channel of the board"
    default "large-update"

config COAP_RX_RESOURCE
    string "CoAP resource - this is the RX channel of the board"
    default "validate"

config COAP_DEVICE_ID
    int "CoAP device id - To know which sensor is speaking"
    default 456789

# - Define PSK Identity configurations
config COAP_DEVICE_NAME
    string "Device resource name - this will be the device name on the CoAP server"
    default "cali.test.nrf91"

config COAP_SERVER_PSK
    string "Server PSK"
    default "2e666f726e69756d"

config DK
	bool "nRF9151 DK, nRF9161 DK or nRF9160 DK"
	default y if (BOARD_NRF9160DK_NRF9160_NS) || (BOARD_NRF9161DK_NRF9161_NS) || (BOARD_NRF9151DK_NRF9151_NS)

config THINGY
	bool "Thingy:91 X or Thingy:91"
	default y if (BOARD_THINGY91_NRF9160_NS) || (BOARD_THINGY91X_NRF9151_NS)


config GNSS_PERIODIC_INTERVAL
    int "Fix interval for periodic GPS fixes"
    range 10 65535
    default 15
    help
        Fix interval (in secounds) for periodic fixes.

config DTLS_SEC_TAG
    int "Indicate where the sec tag is and so the modem knows"
    default 12

config GNSS_PERIODIC_TIMEOUT
    int "Fix timeout for periodic GPS fixes"
    range 0 65535
    default 120
    help
       Fix timeout (in secounds) for periodic fixes.
       If set to zero, GNSS is allowed to run indefinietly unttil a valid PVT estimate is produced.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
